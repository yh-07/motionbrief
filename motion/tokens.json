{
  "styleProfile": "cartoon-tech-v2",
  "version": "2.0.0",
  "canvas": {
    "w": 1080,
    "h": 1920,
    "fps": 30,
    "aspect": "9:16"
  },
  "safeArea": {
    "top": 150,
    "bottom": 380,
    "left": 72,
    "right": 160
  },
  "palette": {
    "maxPrimary": 2,
    "maxAccent": 1,
    "neutrals": [
      "#FFFFFF",
      "#0B1033",
      "#1B1550"
    ],
    "default": {
      "primary": [
        "#7C5CFF",
        "#22D3B6"
      ],
      "accent": "#FFB547"
    }
  },
  "ink": "#0B1033",
  "outline": {
    "width": 0,
    "color": "none",
    "note": "v2: no ink outlines; form from gradients + highlight/shade bands"
  },
  "toon": {
    "bandsMin": 2,
    "bandsMax": 5,
    "bandsDefault": 3
  },
  "background": {
    "gradient": [
      "#1A1452",
      "#070A26"
    ],
    "vignette": 0.5,
    "grain": 0
  },
  "depthLayers": 3,
  "camera": {
    "diagramProjection": "orthographic",
    "heroProjection": "perspective",
    "pushInMax": 1.08
  },
  "easing": {
    "entrance": "easeOutExpo",
    "reveal": "easeOutExpo",
    "emphasis": "spring",
    "impact": "impactPop",
    "exit": "easeInCubic"
  },
  "impactPop": [
    0.96,
    1.03,
    1.0
  ],
  "durations": {
    "entrance": 0.45,
    "reveal": 0.6,
    "impact": 0.35,
    "exit": 0.3,
    "transition": 0.4
  },
  "transitionsAllowed": [
    "cut",
    "zoom_through",
    "mask_reveal",
    "match_cut",
    "morph_fuse"
  ],
  "typography": {
    "fontFamily": "Noto Sans CJK SC, Inter, sans-serif",
    "styles": {
      "impact_reveal": {
        "size": 210,
        "weight": 900,
        "color": "#FFFFFF"
      },
      "headline": {
        "size": 100,
        "weight": 900,
        "color": "#FFFFFF"
      },
      "label": {
        "size": 46,
        "weight": 800,
        "color": "#FFFFFF"
      },
      "caption": {
        "size": 40,
        "weight": 700,
        "color": "#FFFFFF"
      }
    },
    "anchors": {
      "top": 400,
      "center": 960,
      "lower": 1290
    },
    "subtitle": {
      "size": 50,
      "weight": 800,
      "color": "#FFFFFF",
      "stroke": "none",
      "strokeWidth": 0,
      "boxColor": "#070A26",
      "boxOpacity": 0.55,
      "baselineY": 1480,
      "maxCharsPerLine": 14,
      "minDisplaySec": 0.6,
      "maxCharsPerSec": 9.0
    },
    "subtitleLandscape": {
      "size": 50,
      "weight": 800,
      "color": "#14142B",
      "stroke": "none",
      "strokeWidth": 0,
      "boxColor": "#FFD23F",
      "boxOpacity": 0.95,
      "baselineY": 1480,
      "maxCharsPerLine": 18,
      "minDisplaySec": 0.6,
      "maxCharsPerSec": 10.5
    }
  },
  "visualStyles": {
    "neon": {
      "background": {"gradient": ["#2A1F6E", "#070A26"], "vignette": 0.5},
      "band": {"color": "#22D3B6", "opacity": 0.22},
      "headline": {"color": "#FFFFFF"},
      "subtitle": {"size": 50, "weight": 800, "color": "#14142B", "boxColor": "#FFD23F", "boxOpacity": 0.95, "baselineY": 1480}
    },
    "cartoon": {
      "background": {"gradient": ["#FFF1CC", "#FFC9A0"], "vignette": 0.0},
      "band": {"color": "#FF6B4A", "opacity": 0.28},
      "headline": {"color": "#1B1B3A"},
      "subtitle": {"size": 52, "weight": 900, "color": "#FFFFFF", "boxColor": "#1B1B3A", "boxOpacity": 0.92, "baselineY": 1480}
    },
    "ink": {
      "background": {"gradient": ["#F7F4EC", "#E6E0CE"], "vignette": 0.12},
      "band": {"color": "#111111", "opacity": 0.0},
      "headline": {"color": "#111111"},
      "subtitle": {"size": 48, "weight": 600, "color": "#111111", "boxColor": "#FFFFFF", "boxOpacity": 1.0, "baselineY": 1480}
    },
    "graphite": {
      "background": {"gradient": ["#1C2029", "#0B0D12"], "vignette": 0.25},
      "band": {"color": "#94A3B8", "opacity": 0.0},
      "headline": {"color": "#F8FAFC"},
      "subtitle": {"size": 50, "weight": 700, "color": "#F8FAFC", "boxColor": "#000000", "boxOpacity": 0.5, "baselineY": 1700}
    }
  },
  "cadence": {
    "hookWithinSec": 3.0,
    "maxVisualGapSec": 5.0,
    "avgCutMinSec": 2.0,
    "avgCutMaxSec": 4.0
  },
  "audio": {
    "targetLUFS": -14.0,
    "toleranceLU": 2.0,
    "sampleRate": 48000
  },
  "forbidden": {
    "transitions": [
      "fade",
      "dissolve",
      "wipe",
      "spin",
      "whip"
    ],
    "typographyStyles": [
      "yellow_stroke_bigtext",
      "ink_outline_box"
    ],
    "emojiInText": true
  },
  "duration": {
    "hardMinSec": 15,
    "hardMaxSec": 420,
    "hardMaxSecLandscape": 900,
    "note": "Hard bounds only guard against broken IR. Tiers are advisory targets (warnings). Shorts accept up to 3 min; >180 s is the long-form variant (e.g. ISP v3 full cut, 4 min, published with a 60 s Shorts trailer). Landscape (16:9) deep-science videos use the longform tier, 8-15 min.",
    "tiers": {
      "micro": [
        20,
        40
      ],
      "core": [
        45,
        75
      ],
      "deep": [
        75,
        120
      ],
      "extended": [
        120,
        420
      ],
      "longform": [
        480,
        900
      ]
    },
    "voiceTailSec": 0.35,
    "voiceLeadSec": 0.15,
    "maxTempo": 1.15
  }
}
